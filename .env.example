SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
PORT=9000
JWT_SECRET=your-jwt-secret
COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_CLIENT_SECRET=your-cognito-client-secret
COGNITO_REDIRECT_URI=http://localhost:9000/api/auth/callback
WEB_URL=http://localhost:3000

# Master token for API access (optional)
# When set, any request with "Authorization: Bearer <MASTER_TOKEN>" bypasses JWT auth
# Use this to let agents access HTTP API without Cognito login
MASTER_TOKEN=
